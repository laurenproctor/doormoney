# Copy to .env.local. The app runs without any of these (sample data, pretend forms).

# Public site URL. Sets the widget snippet and absolute links. Decision 5 in docs/DECISIONS.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never exposed to the browser

# Stripe (test mode until Phase 7)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=            # from `stripe listen` locally, dashboard in prod

# Email (Phase 1). Both are needed before any email goes out; without them sends are skipped and logged.
RESEND_API_KEY=
EMAIL_FROM=                       # e.g. "Door Money <hello@<domain>>", a sender verified in Resend
