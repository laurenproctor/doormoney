# Copy to .env.local. The app runs without any of these (sample data, pretend forms).

# Public site URL. Sets the widget snippet and absolute links. Decision 5 in docs/DECISIONS.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never exposed to the browser

# Stripe (test mode until Phase 7)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=            # from `stripe listen` locally, dashboard in prod

# Email (Phase 1). Both are needed before any email goes out; without them sends are skipped and logged.
RESEND_API_KEY=
EMAIL_FROM=                       # e.g. "Door Money <hello@<domain>>", a sender verified in Resend
CONTACT_TO_EMAIL=                 # where notes from /contact are sent. Without it, notes are stored but nobody is notified.
ALERTS_TO_EMAIL=                  # where automated financial alarms go (failed transfers, patron flags, an unbalanced ledger event).
                                  # Falls back to CONTACT_TO_EMAIL when unset, so a dispute would sit under a press inquiry.

# Scheduled work. The three /api/cron routes answer 401 without it. Vercel Cron sends it on its own
# once the variable exists; the five-minute auction worker reads its copy from Supabase Vault
# (docs/PHASE_3_DEPLOYMENT.md). Generate with: openssl rand -hex 32
CRON_SECRET=

# Door Money staff. Comma-separated emails allowed into /admin, and only once the address is
# confirmed (src/lib/admin.ts). Everyone else gets a 404. Keep "Confirm email" on in the hosted
# project's Auth settings: with it off, signing up with a listed address is enough.
ADMIN_EMAILS=
